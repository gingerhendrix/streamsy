{
  "name": "hackernews-newest-stream",
  "version": "0.0.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run build && bun run src/server/index.ts",
    "dev:api": "bun run src/server/index.ts",
    "build": "bun run scripts/build-client.ts",
    "start": "bun run build && bun run src/server/index.ts",
    "smoke:http": "bun run scripts/http-smoke.ts",
    "test": "bun run test:unit",
    "typecheck": "tsc --noEmit",
    "test:unit": "bun --bun vitest run --dir test"
  },
  "dependencies": {
    "@durable-streams/state": "^0.3.2",
    "@effect/platform-bun": "4.0.5",
    "@streamsy/core": "workspace:*",
    "@streamsy/projection": "workspace:*",
    "@streamsy/serve": "workspace:*",
    "@streamsy/storage": "workspace:*",
    "@tanstack/db": "0.15.1",
    "@tanstack/react-db": "^0.5.11",
    "effect": "4.0.5",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@streamsy/test-support": "workspace:*",
    "@types/bun": "^1.4.3",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "vitest": "catalog:"
  }
}
