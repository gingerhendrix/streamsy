{
  "name": "issue-tracker",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run build && bun --hot server/local.ts",
    "start": "bun server/local.ts",
    "build": "bun run generate:check && bun run scripts/build.ts",
    "generate": "bun run generate:board && bun run generate:label-counts",
    "generate:board": "bun ../../packages/tanstack-db/src/cli.ts --module $PWD/domain/declaration.ts --export boardIssues --output $PWD/src/generated/board-issues.ts",
    "generate:label-counts": "bun ../../packages/tanstack-db/src/cli.ts --module $PWD/domain/declaration.ts --export boardLabelCounts --output $PWD/src/generated/label-counts.ts",
    "generate:check": "bun run generate:check:board && bun run generate:check:label-counts",
    "generate:check:board": "bun ../../packages/tanstack-db/src/cli.ts --module $PWD/domain/declaration.ts --export boardIssues --output $PWD/src/generated/board-issues.ts --check",
    "generate:check:label-counts": "bun ../../packages/tanstack-db/src/cli.ts --module $PWD/domain/declaration.ts --export boardLabelCounts --output $PWD/src/generated/label-counts.ts --check",
    "typecheck": "tsc --noEmit",
    "test": "bun test test",
    "test:cloudflare": "bun test test/cloudflare-workspace.test.ts test/cloudflare-parity.test.ts",
    "build:cloudflare": "bun build server/cloudflare.ts --outdir dist/cloudflare --target browser --format esm --external cloudflare:workers",
    "smoke:http": "bun run scripts/http-smoke.ts",
    "smoke:ui": "bun run scripts/ui-smoke.ts",
    "app:full": "bun run scripts/full-app.ts"
  },
  "dependencies": {
    "@durable-streams/client": "^0.2.6",
    "@durable-streams/state": "^0.3.1",
    "@effect/sql-sqlite-bun": "4.0.0-rc.112",
    "@effect/sql-sqlite-do": "4.0.0-rc.112",
    "@streamsy/core": "workspace:*",
    "@streamsy/effect-sink": "workspace:*",
    "@streamsy/experimental": "workspace:*",
    "@streamsy/json": "workspace:*",
    "@streamsy/sinks": "workspace:*",
    "@streamsy/state": "workspace:*",
    "@streamsy/state-sink": "workspace:*",
    "@streamsy/storage-sqlite": "workspace:*",
    "@streamsy/tanstack-db": "workspace:*",
    "@streamsy/views": "workspace:*",
    "@streamsy/views-engine": "workspace:*",
    "@streamsy/views-ir": "workspace:*",
    "@streamsy/views-store": "workspace:*",
    "@tanstack/db": "0.6.8",
    "@tanstack/react-db": "^0.1.83",
    "effect": "4.0.0-rc.112",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@types/bun": "^1.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "miniflare": "4.20260730.0",
    "typescript": "catalog:"
  }
}
