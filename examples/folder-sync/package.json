{
  "name": "folder-sync",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run build:web && bun --hot server/index.ts",
    "start": "bun run build:web && bun server/index.ts",
    "test": "bun run test:unit",
    "test:unit": "bun --bun vitest run --dir test",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "smoke:http": "bun run build:web && bun scripts/http-smoke.ts",
    "sync": "bun sync/index.ts",
    "build:web": "vite build",
    "dev:web": "vite --host 127.0.0.1",
    "seed": "bun scripts/seed.ts",
    "smoke:worker": "bun run build:web && bun run build:worker && bun scripts/worker-smoke.ts",
    "build:worker": "bun scripts/build-worker.ts",
    "dev:worker": "bun run build:web && bun run build:worker && bun scripts/local-worker.ts",
    "test:worker": "bun run build:worker && bun --bun vitest run test/worker test/agent/worker.test.ts && FOLDER_SYNC_TEST_WORKER=true bun --bun vitest run test/sync/integration.test.ts"
  },
  "dependencies": {
    "@better-fs-tools/fs": "0.1.0",
    "@durable-streams/state": "^0.3.2",
    "@effect/platform-bun": "4.0.5",
    "@effect/sql-sqlite-bun": "4.0.5",
    "@streamsy/core": "workspace:*",
    "@streamsy/projection": "workspace:*",
    "@streamsy/serve": "workspace:*",
    "@streamsy/storage": "workspace:*",
    "@tanstack/db": "0.15.1",
    "@tanstack/react-db": "^0.5.11",
    "effect": "4.0.5",
    "just-bash": "3.6.0",
    "picomatch": "^4.0.7",
    "react": "latest",
    "react-dom": "latest",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20251228.0",
    "@effect/vitest": "catalog:",
    "@streamsy/test-support": "workspace:*",
    "@types/picomatch": "^4.0.2",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "alchemy": "2.0.0-beta.83",
    "bun-types": "^1.4.3",
    "miniflare": "4.20260730.0",
    "typescript": "catalog:",
    "vite": "^8.0.7",
    "vitest": "catalog:"
  }
}
