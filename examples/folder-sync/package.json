{
  "name": "folder-sync",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run build:web && bun --hot server/index.ts",
    "start": "bun run build:web && bun server/index.ts",
    "test": "bun run build:web && bun run test:unit",
    "test:unit": "bun test test",
    "typecheck": "tsc --noEmit",
    "smoke:http": "bun run build:web && bun scripts/http-smoke.ts",
    "sync": "bun sync/index.ts",
    "build:web": "vite build",
    "dev:web": "vite --host 127.0.0.1",
    "seed": "bun scripts/seed.ts"
  },
  "dependencies": {
    "@durable-streams/state": "^0.3.1",
    "@effect/platform-bun": "4.0.1",
    "@effect/sql-sqlite-bun": "4.0.1",
    "@streamsy/core": "workspace:*",
    "@streamsy/projection": "workspace:*",
    "@streamsy/serve": "workspace:*",
    "@streamsy/storage": "workspace:*",
    "@tanstack/db": "0.6.8",
    "@tanstack/react-db": "^0.1.83",
    "effect": "4.0.1",
    "react": "latest",
    "react-dom": "latest",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@streamsy/effect-test": "workspace:*",
    "@streamsy/test-support": "workspace:*",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "bun-types": "^1.3.14",
    "typescript": "catalog:",
    "vite": "^8.0.7"
  }
}
