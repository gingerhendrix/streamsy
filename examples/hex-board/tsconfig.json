{
  "compilerOptions": {
    "plugins": [{ "name": "@effect/language-service", "barrelImportPackages": ["effect"] }],
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "strict": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["bun"]
  },
  "include": ["src", "test"]
}
