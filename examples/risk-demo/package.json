{
  "name": "risk-demo",
  "version": "0.0.1",
  "private": true,
  "description": "Deterministic, headless event-sourced Streamsy Risk demo: kernel, projection materializer, and durable command API.",
  "type": "module",
  "scripts": {
    "demo": "bash scripts/run-demo.sh",
    "dev": "bun --hot server/index.ts",
    "start": "NODE_ENV=production bun server/index.ts",
    "bot": "bun run scripts/bot.ts",
    "smoke:http": "bun run scripts/http-smoke.ts",
    "proof": "bun run scripts/proof.ts",
    "rebuild": "bun run scripts/rebuild.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run src server test/integration",
    "test:unit": "vitest --run src server",
    "test:sqlite": "bun test test/persistence"
  },
  "dependencies": {
    "@durable-streams/state": "^0.3.1",
    "@streamsy/core": "workspace:*",
    "@streamsy/experimental": "workspace:*",
    "@streamsy/json": "workspace:*",
    "@streamsy/state": "workspace:*",
    "@streamsy/storage-sqlite": "workspace:*",
    "@tanstack/db": "0.6.8",
    "@tanstack/react-db": "^0.1.83",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "bun-types": "^1.3.14",
    "typescript": "catalog:",
    "vitest": "^4.0.16"
  }
}
