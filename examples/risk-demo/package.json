{
  "name": "risk-demo",
  "version": "0.0.1",
  "private": true,
  "description": "Playable event-sourced Hex Domination on Bun and SQLite.",
  "type": "module",
  "scripts": {
    "demo": "bash scripts/run-demo.sh",
    "dev": "bun --hot server/index.ts",
    "start": "NODE_ENV=production bun server/index.ts",
    "bot": "bun run scripts/bot.ts",
    "smoke:http": "bun run scripts/http-smoke.ts",
    "rebuild": "bun run scripts/rebuild.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun --bun vitest run src server test/integration test/persistence",
    "test:unit": "bun run test",
    "test:sqlite": "bun --bun vitest run test/persistence"
  },
  "dependencies": {
    "@durable-streams/state": "^0.3.2",
    "@effect/platform-bun": "4.1.2",
    "@effect/sql-sqlite-bun": "4.1.2",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@streamsy/core": "workspace:*",
    "@streamsy/projection": "workspace:*",
    "@streamsy/serve": "workspace:*",
    "@streamsy/storage": "workspace:*",
    "@tanstack/db": "0.15.1",
    "@tanstack/react-db": "0.5.11",
    "effect": "4.1.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
