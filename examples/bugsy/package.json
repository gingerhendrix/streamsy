{
  "name": "bugsy",
  "version": "0.0.3",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run server/index.ts",
    "app:full": "bun run scripts/full-app.ts",
    "smoke:http": "bun run scripts/http-smoke.ts",
    "run:once": "bun run scripts/run-once.ts",
    "test": "bun --bun vitest run --dir test",
    "test:unit": "bun --bun vitest run --dir test",
    "test:dialects": "bun --bun vitest run --dir test-dialects",
    "typecheck": "tsc --noEmit",
    "smoke:serve": "bun run scripts/serve-smoke.ts"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.5",
    "@effect/sql-mysql2": "4.0.5",
    "@effect/sql-pg": "4.0.5",
    "@effect/sql-sqlite-bun": "4.0.5",
    "@streamsy/core": "workspace:*",
    "@streamsy/projection": "workspace:*",
    "@streamsy/serve": "workspace:*",
    "@streamsy/storage": "workspace:*",
    "effect": "4.0.5",
    "typescript": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@streamsy/test-support": "workspace:*",
    "@types/bun": "^1.4.3",
    "vitest": "catalog:"
  }
}
