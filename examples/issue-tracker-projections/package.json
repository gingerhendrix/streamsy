{
  "name": "issue-tracker-projections",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run build && bun --hot server/local.ts",
    "start": "bun server/local.ts",
    "build": "bun run scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run test --exclude '**/*.bun.test.ts' && bun test test/*.bun.test.ts",
    "test:vertical": "vitest --run test/vertical-path.test.ts",
    "test:recovery": "bun test test/*.bun.test.ts",
    "smoke:http": "bun run scripts/http-smoke.ts",
    "smoke:ui": "bun run scripts/ui-smoke.ts",
    "seed:check": "bun run scripts/seed-check.ts",
    "deploy:check": "bun run scripts/deploy-check.ts",
    "audit:state": "bun run scripts/alchemy-state-audit.ts",
    "plan:demo": "alchemy plan",
    "deploy:demo": "alchemy deploy",
    "destroy:demo": "alchemy destroy --yes",
    "smoke:deployment": "bun run scripts/deployment-smoke.ts"
  },
  "dependencies": {
    "@streamsy/client": "workspace:*",
    "@streamsy/core": "workspace:*",
    "@streamsy/experimental": "workspace:*",
    "@streamsy/storage-durable-object": "workspace:*",
    "effect": "4.0.0-rc.112",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@effect/platform-bun": "4.0.0-rc.112",
    "@effect/platform-node": "4.0.0-rc.112",
    "@streamsy/storage-sqlite": "workspace:*",
    "@types/bun": "^1.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "alchemy": "2.0.0-beta.74",
    "typescript": "catalog:",
    "vitest": "^4.0.16"
  }
}
