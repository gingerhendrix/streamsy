{
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": [
    "test/lib/moved-pages.test.ts",
    "test/scripts/check-excerpts.test.ts",
    "test/scripts/check-example-excerpts.test.ts",
    "test/scripts/docs-deployment-targets.test.ts",
    "test/twoslash.test.ts"
  ],
  "compilerOptions": {
    "plugins": [{ "name": "@effect/language-service", "barrelImportPackages": ["effect"] }],
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "paths": {
      "#/*": ["./src/*"],
      "@/*": ["./src/*"],
      "collections/*": ["./.source/*"]
    },
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  }
}
