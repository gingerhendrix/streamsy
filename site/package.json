{
  "name": "streamsy-docs",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "bun run --cwd .. build && vite build",
    "preview": "vite preview",
    "check": "fumadocs-mdx && tsc --noEmit",
    "deploy": "alchemy deploy",
    "destroy": "alchemy destroy",
    "check:deploy-targets": "bun test test/scripts/docs-deployment-targets.test.ts",
    "check:og": "bun run scripts/check-og-image.ts",
    "check:terms": "bun run scripts/check-stale-terms.ts",
    "check:links": "bun run scripts/check-links.ts",
    "check:twoslash": "bun test test/twoslash.test.ts",
    "check:demos": "bun run scripts/check-demo-excerpts.ts && bun test test/scripts/check-demo-excerpts.test.ts",
    "check:excerpts": "bun run --cwd ../packages/core build && bun run --cwd ../packages/storage build && bun run --cwd ../packages/serve build && bun run --cwd ../packages/core typecheck && bun run --cwd ../packages/storage typecheck && bun run --cwd ../packages/serve typecheck && bun run --cwd ../e2e typecheck && bun run scripts/check-excerpts.ts && bun test test/scripts/check-excerpts.test.ts"
  },
  "dependencies": {
    "@fontsource/knewave": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-start": "1.169.3",
    "@tanstack/router-plugin": "1.168.47",
    "alchemy": "^0.94.0",
    "fumadocs-core": "16.16.2",
    "fumadocs-mdx": "15.4.6",
    "fumadocs-twoslash": "4.0.2",
    "fumadocs-ui": "16.16.2",
    "geist": "^1.8.1",
    "lucide-react": "^1.59.0",
    "nitro": "npm:nitro-nightly@3.0.1-20260227-181935-bfbb207c",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shiki": "4.5.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-mdx": "3.0.0",
    "mdast-util-to-markdown": "2.2.0",
    "micromark-extension-mdxjs": "3.0.0",
    "typescript": "^7.0.2",
    "vite": "8.3.4",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
