{
  "name": "@streamsy/storage",
  "version": "0.3.0",
  "description": "Effect SQL storage for Streamsy on SQLite, Postgres and MySQL, with Bun and Durable Object SQLite host layers.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gingerhendrix/streamsy.git",
    "directory": "packages/storage"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./bun": {
      "types": "./dist/bun.d.ts",
      "import": "./dist/bun.js",
      "default": "./dist/bun.js"
    },
    "./durable-object": {
      "types": "./dist/durable-object.d.ts",
      "import": "./dist/durable-object.js",
      "default": "./dist/durable-object.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown src/index.ts src/bun.ts src/durable-object.ts --format esm --dts --out-dir dist --clean --deps.never-bundle effect --deps.never-bundle bun:sqlite --deps.never-bundle @streamsy/core --deps.never-bundle @effect/platform-bun --deps.never-bundle @effect/sql-sqlite-bun --deps.never-bundle @effect/sql-sqlite-do",
    "typecheck": "tsc --noEmit",
    "test:unit": "bun --bun vitest run --dir test",
    "test:dialects": "bun --bun vitest run test/dialects"
  },
  "dependencies": {
    "@streamsy/core": "workspace:^"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20251228.0",
    "@effect/platform-bun": "4.0.5",
    "@effect/sql-mysql2": "4.0.5",
    "@effect/sql-pg": "4.0.5",
    "@effect/sql-sqlite-bun": "4.0.5",
    "@effect/sql-sqlite-do": "4.0.5",
    "@effect/vitest": "catalog:",
    "@streamsy/serve": "workspace:*",
    "@types/bun": "^1.4.3",
    "effect": "4.0.5",
    "miniflare": "4.20260730.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@effect/platform-bun": "^4.0.5",
    "@effect/sql-sqlite-bun": "^4.0.5",
    "@effect/sql-sqlite-do": "^4.0.5",
    "effect": "^4.0.5"
  },
  "peerDependenciesMeta": {
    "@effect/platform-bun": {
      "optional": true
    },
    "@effect/sql-sqlite-bun": {
      "optional": true
    },
    "@effect/sql-sqlite-do": {
      "optional": true
    }
  },
  "tsdown": {
    "fixedExtension": false,
    "tsconfig": "tsconfig.build.json"
  }
}
