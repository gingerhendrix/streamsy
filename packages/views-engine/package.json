{
  "name": "@streamsy/views-engine",
  "version": "0.2.1",
  "description": "Pure incremental graph runtime for Streamsy view plans.",
  "homepage": "https://github.com/gingerhendrix/streamsy#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gingerhendrix/streamsy.git",
    "directory": "packages/views-engine"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./conformance": {
      "types": "./dist/conformance.d.ts",
      "import": "./dist/conformance.js",
      "default": "./dist/conformance.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown src/index.ts src/conformance.ts --format esm --dts --out-dir dist --clean --external @streamsy/views-ir",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest --run src"
  },
  "dependencies": {
    "@streamsy/views-ir": "workspace:*"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "^4.0.16"
  }
}
