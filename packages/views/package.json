{
  "name": "@streamsy/views",
  "version": "0.5.0",
  "description": "Incremental SQL views over Streamsy State collections, run as projections.",
  "homepage": "https://github.com/gingerhendrix/streamsy-extras/tree/main/packages/views#readme",
  "bugs": {
    "url": "https://github.com/gingerhendrix/streamsy-extras/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gingerhendrix/streamsy-extras.git",
    "directory": "packages/views"
  },
  "files": [
    "dist",
    "docs"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/relation.js",
  "types": "./dist/relation.d.ts",
  "exports": {
    ".": {
      "types": "./dist/relation.d.ts",
      "import": "./dist/relation.js",
      "default": "./dist/relation.js"
    },
    "./ir": {
      "types": "./dist/ir/contracts.d.ts",
      "import": "./dist/ir/contracts.js",
      "default": "./dist/ir/contracts.js"
    },
    "./sql": {
      "types": "./dist/sql/engine.d.ts",
      "import": "./dist/sql/engine.js",
      "default": "./dist/sql/engine.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown src/relation.ts src/ir/contracts.ts src/sql/engine.ts --format esm --dts --out-dir dist --clean --deps.never-bundle effect",
    "typecheck": "tsc --noEmit",
    "test:unit": "bun test test"
  },
  "dependencies": {
    "effect": "4.1.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20251228.0",
    "@effect/platform-bun": "4.1.2",
    "@effect/sql-sqlite-bun": "4.1.2",
    "@effect/sql-sqlite-do": "4.1.2",
    "@streamsy/core": "0.12.0",
    "@streamsy/projection": "0.12.0",
    "@streamsy/storage": "0.12.0",
    "@types/bun": "^1.2.0",
    "miniflare": "4.20260730.0",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@streamsy/core": "~0.12.0",
    "@streamsy/projection": "~0.12.0"
  },
  "tsdown": {
    "fixedExtension": false
  }
}
