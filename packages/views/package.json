{
  "name": "@streamsy/views",
  "version": "0.4.0",
  "description": "Typed view authoring, the serializable plan IR, the incremental engine, and maintained-view storage for Streamsy.",
  "homepage": "https://github.com/gingerhendrix/streamsy#readme",
  "bugs": {
    "url": "https://github.com/gingerhendrix/streamsy/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gingerhendrix/streamsy.git",
    "directory": "packages/views"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/relation.js",
  "types": "./dist/relation.d.ts",
  "exports": {
    ".": {
      "types": "./dist/relation.d.ts",
      "import": "./dist/relation.js",
      "default": "./dist/relation.js"
    },
    "./ir": {
      "types": "./dist/ir/contracts.d.ts",
      "import": "./dist/ir/contracts.js",
      "default": "./dist/ir/contracts.js"
    },
    "./engine": {
      "types": "./dist/engine/engine.d.ts",
      "import": "./dist/engine/engine.js",
      "default": "./dist/engine/engine.js"
    },
    "./engine/conformance": {
      "types": "./dist/engine/reference.d.ts",
      "import": "./dist/engine/reference.js",
      "default": "./dist/engine/reference.js"
    },
    "./store": {
      "types": "./dist/store/memory.d.ts",
      "import": "./dist/store/memory.js",
      "default": "./dist/store/memory.js"
    },
    "./store/sqlite": {
      "types": "./dist/store/sqlite.d.ts",
      "import": "./dist/store/sqlite.js",
      "default": "./dist/store/sqlite.js"
    },
    "./store/conformance": {
      "types": "./dist/store/conformance.d.ts",
      "import": "./dist/store/conformance.js",
      "default": "./dist/store/conformance.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown src/relation.ts src/ir/contracts.ts src/engine/engine.ts src/engine/reference.ts src/store/memory.ts src/store/sqlite.ts src/store/conformance.ts --format esm --dts --out-dir dist --clean --external effect --external bun:sqlite --external bun:test",
    "typecheck": "tsc --noEmit",
    "test:unit": "bun test src"
  },
  "dependencies": {
    "effect": "4.0.0-rc.115"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "typescript": "catalog:"
  }
}
