{
  "name": "@streamsy/views",
  "version": "0.5.0",
  "private": true,
  "description": "Incremental SQL views over Streamsy State collections, run as projections.",
  "homepage": "https://github.com/gingerhendrix/streamsy/tree/main/packages/views#readme",
  "bugs": {
    "url": "https://github.com/gingerhendrix/streamsy/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gingerhendrix/streamsy.git",
    "directory": "packages/views"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/relation.js",
  "types": "./dist/relation.d.ts",
  "exports": {
    ".": {
      "types": "./dist/relation.d.ts",
      "import": "./dist/relation.js",
      "default": "./dist/relation.js"
    },
    "./ir": {
      "types": "./dist/ir/contracts.d.ts",
      "import": "./dist/ir/contracts.js",
      "default": "./dist/ir/contracts.js"
    },
    "./sql": {
      "types": "./dist/sql/engine.d.ts",
      "import": "./dist/sql/engine.js",
      "default": "./dist/sql/engine.js"
    }
  },
  "scripts": {
    "build": "tsdown src/relation.ts src/ir/contracts.ts src/sql/engine.ts --format esm --dts --out-dir dist --clean --deps.never-bundle effect --deps.never-bundle @streamsy/core --deps.never-bundle @streamsy/projection",
    "typecheck": "tsc --noEmit",
    "test:unit": "bun --bun vitest run --dir test --exclude \"**/workerd.test.ts\"",
    "test:workerd": "bun --bun vitest run test/circuit/workerd.test.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@effect/platform-bun": "4.1.2",
    "@effect/sql-sqlite-bun": "4.1.2",
    "@effect/sql-sqlite-do": "4.1.2",
    "@effect/vitest": "catalog:",
    "@streamsy/core": "workspace:*",
    "@streamsy/projection": "workspace:*",
    "@streamsy/storage": "workspace:*",
    "@tanstack/db-ivm": "0.2.0",
    "@types/bun": "^1.4.3",
    "effect": "4.1.2",
    "miniflare": "4.20260730.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@streamsy/core": "~0.12.0",
    "@streamsy/projection": "~0.12.0",
    "effect": "^4.1.2"
  },
  "tsdown": {
    "fixedExtension": false,
    "tsconfig": "tsconfig.build.json"
  }
}
