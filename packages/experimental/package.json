{
  "name": "@streamsy/experimental",
  "version": "0.2.1",
  "description": "Experimental primitives for Streamsy durable streams.",
  "homepage": "https://github.com/gingerhendrix/streamsy#readme",
  "bugs": {
    "url": "https://github.com/gingerhendrix/streamsy/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gingerhendrix/streamsy.git",
    "directory": "packages/experimental"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./binding": {
      "types": "./dist/binding.d.ts",
      "import": "./dist/binding.js",
      "default": "./dist/binding.js"
    },
    "./causal": {
      "types": "./dist/causal.d.ts",
      "import": "./dist/causal.js",
      "default": "./dist/causal.js"
    },
    "./materializer": {
      "types": "./dist/materializer.d.ts",
      "import": "./dist/materializer.js",
      "default": "./dist/materializer.js"
    },
    "./ivm-mesh": {
      "types": "./dist/ivm-mesh.d.ts",
      "import": "./dist/ivm-mesh.js",
      "default": "./dist/ivm-mesh.js"
    },
    "./effect": {
      "types": "./dist/effect.d.ts",
      "import": "./dist/effect.js",
      "default": "./dist/effect.js"
    },
    "./effect/state-projection": {
      "types": "./dist/effect-state-projection.d.ts",
      "import": "./dist/effect-state-projection.js",
      "default": "./dist/effect-state-projection.js"
    },
    "./effect/testing": {
      "types": "./dist/effect-testing.d.ts",
      "import": "./dist/effect-testing.js",
      "default": "./dist/effect-testing.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown src/binding.ts src/causal.ts src/effect.ts src/effect-state-projection.ts src/effect-testing.ts src/ivm-mesh.ts src/materializer.ts --format esm --dts --out-dir dist --clean --external @streamsy/core --external effect",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest --run src --exclude '**/*.bun.test.ts'",
    "test:sqlite": "bun test src/ivm-mesh/*.bun.test.ts"
  },
  "dependencies": {
    "@streamsy/core": "0.2.1",
    "effect": "4.0.0-beta.99"
  },
  "devDependencies": {
    "@streamsy/client": "workspace:*",
    "@streamsy/storage-sqlite": "workspace:*",
    "typescript": "catalog:",
    "vitest": "^4.0.16"
  }
}
