{
  "name": "@streamsy/sinks",
  "version": "0.3.0",
  "description": "Checked state, stream, document, and action sink contracts, routes, protocol handling, and Effect server adapters.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/state.d.ts",
      "import": "./dist/state.js",
      "default": "./dist/state.js"
    },
    "./stream": {
      "types": "./dist/stream.d.ts",
      "import": "./dist/stream.js",
      "default": "./dist/stream.js"
    },
    "./document": {
      "types": "./dist/document.d.ts",
      "import": "./dist/document.js",
      "default": "./dist/document.js"
    },
    "./route": {
      "types": "./dist/route.d.ts",
      "import": "./dist/route.js",
      "default": "./dist/route.js"
    },
    "./route-params": {
      "types": "./dist/route-params.d.ts",
      "import": "./dist/route-params.js",
      "default": "./dist/route-params.js"
    },
    "./fingerprint": {
      "types": "./dist/fingerprint.d.ts",
      "import": "./dist/fingerprint.js",
      "default": "./dist/fingerprint.js"
    },
    "./server/state": {
      "types": "./dist/server/state.d.ts",
      "import": "./dist/server/state.js",
      "default": "./dist/server/state.js"
    },
    "./server/stream": {
      "types": "./dist/server/stream.d.ts",
      "import": "./dist/server/stream.js",
      "default": "./dist/server/stream.js"
    },
    "./server/document": {
      "types": "./dist/server/document.d.ts",
      "import": "./dist/server/document.js",
      "default": "./dist/server/document.js"
    },
    "./action": {
      "types": "./dist/action/contract.d.ts",
      "import": "./dist/action/contract.js",
      "default": "./dist/action/contract.js"
    },
    "./action/errors": {
      "types": "./dist/action/errors.d.ts",
      "import": "./dist/action/errors.js",
      "default": "./dist/action/errors.js"
    },
    "./action/outbox": {
      "types": "./dist/action/outbox.d.ts",
      "import": "./dist/action/outbox.js",
      "default": "./dist/action/outbox.js"
    },
    "./action/runtime": {
      "types": "./dist/action/runtime.d.ts",
      "import": "./dist/action/runtime.js",
      "default": "./dist/action/runtime.js"
    },
    "./action/sqlite": {
      "types": "./dist/action/sqlite.d.ts",
      "import": "./dist/action/sqlite.js",
      "default": "./dist/action/sqlite.js"
    }
  },
  "scripts": {
    "build": "tsdown src/state.ts src/stream.ts src/document.ts src/route.ts src/route-params.ts src/fingerprint.ts src/server/state.ts src/server/stream.ts src/server/document.ts src/action/contract.ts src/action/errors.ts src/action/outbox.ts src/action/runtime.ts src/action/sqlite.ts --format esm --dts --out-dir dist --clean --external effect --external bun:sqlite",
    "typecheck": "tsc --noEmit",
    "test:unit": "bun test src"
  },
  "dependencies": {
    "effect": "4.0.0-rc.112"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "typescript": "catalog:"
  }
}
