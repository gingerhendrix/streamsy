{
  "name": "@streamsy/sinks",
  "version": "0.1.0",
  "description": "Checked stream-sink and document-sink contracts, routes, and Effect server adapters.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./effect": {
      "types": "./dist/effect.d.ts",
      "import": "./dist/effect.js",
      "default": "./dist/effect.js"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts src/effect.ts --format esm --dts --out-dir dist --clean --external effect --external @streamsy/state-sink",
    "typecheck": "tsc --noEmit",
    "test:unit": "bun test src"
  },
  "dependencies": {
    "@streamsy/state-sink": "workspace:*",
    "effect": "4.0.0-rc.112"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "typescript": "catalog:"
  }
}
