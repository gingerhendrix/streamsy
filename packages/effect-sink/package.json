{
  "name": "@streamsy/effect-sink",
  "version": "0.1.0",
  "description": "Checked effect-sink declarations, a durable outbox, serialized retry, and dead-letter delivery.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./sqlite": {
      "types": "./dist/sqlite.d.ts",
      "import": "./dist/sqlite.js",
      "default": "./dist/sqlite.js"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts src/sqlite.ts --format esm --dts --out-dir dist --clean --external effect --external bun:sqlite",
    "typecheck": "tsc --noEmit",
    "test:unit": "bun test src"
  },
  "dependencies": {
    "effect": "4.0.0-rc.112"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "typescript": "catalog:"
  }
}
