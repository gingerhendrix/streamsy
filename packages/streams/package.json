{
  "name": "@streamsy/streams",
  "version": "0.3.0",
  "description": "Effect-native stream capabilities, bindings, and stream identity for Streamsy durable streams.",
  "homepage": "https://github.com/gingerhendrix/streamsy#readme",
  "bugs": {
    "url": "https://github.com/gingerhendrix/streamsy/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gingerhendrix/streamsy.git",
    "directory": "packages/streams"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/streams.d.ts",
      "import": "./dist/streams.js",
      "default": "./dist/streams.js"
    },
    "./binding": {
      "types": "./dist/binding.d.ts",
      "import": "./dist/binding.js",
      "default": "./dist/binding.js"
    },
    "./identity": {
      "types": "./dist/identity.d.ts",
      "import": "./dist/identity.js",
      "default": "./dist/identity.js"
    },
    "./causal": {
      "types": "./dist/causal.d.ts",
      "import": "./dist/causal.js",
      "default": "./dist/causal.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    },
    "./test-layers": {
      "types": "./dist/test-layers.d.ts",
      "import": "./dist/test-layers.js",
      "default": "./dist/test-layers.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown src/streams.ts src/binding.ts src/identity.ts src/causal.ts src/testing.ts src/test-layers.ts --format esm --out-dir dist --clean --external @streamsy/core --external effect && tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest --run src --exclude '**/*.bun.test.ts'"
  },
  "dependencies": {
    "@streamsy/core": "0.3.0",
    "effect": "4.0.0-rc.112"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "^4.0.16"
  }
}
