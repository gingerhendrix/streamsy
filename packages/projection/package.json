{
  "name": "@streamsy/projection",
  "version": "0.3.0",
  "description": "Checkpointed Effect projections over one or more retained streams.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gingerhendrix/streamsy.git",
    "directory": "packages/projection"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./checkpoint": {
      "types": "./dist/checkpoint.d.ts",
      "import": "./dist/checkpoint.js",
      "default": "./dist/checkpoint.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown src/index.ts src/checkpoint.ts --format esm --dts --out-dir dist --clean --deps.never-bundle effect --deps.never-bundle @streamsy/core",
    "typecheck": "tsc --noEmit",
    "test:unit": "bun --bun vitest run --dir test",
    "test:dialects": "bun --bun vitest run test/sql-dialects.test.ts"
  },
  "dependencies": {
    "@streamsy/core": "workspace:^"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20251228.0",
    "@effect/platform-bun": "4.0.5",
    "@effect/sql-mysql2": "4.0.5",
    "@effect/sql-pg": "4.0.5",
    "@effect/sql-sqlite-bun": "4.0.5",
    "@effect/sql-sqlite-do": "4.0.5",
    "@effect/vitest": "catalog:",
    "@streamsy/serve": "workspace:*",
    "@streamsy/storage": "workspace:*",
    "@types/bun": "^1.4.3",
    "effect": "4.0.5",
    "miniflare": "4.20260730.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "effect": "^4.0.5"
  },
  "tsdown": {
    "fixedExtension": false,
    "tsconfig": "tsconfig.build.json"
  }
}
