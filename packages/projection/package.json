{
  "name": "@streamsy/projection",
  "version": "0.4.0",
  "description": "Checkpointed Effect projections over one or more retained streams.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gingerhendrix/streamsy.git",
    "directory": "packages/projection"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./memory": {
      "types": "./dist/memory.d.ts",
      "import": "./dist/memory.js",
      "default": "./dist/memory.js"
    },
    "./sqlite": {
      "types": "./dist/sqlite.d.ts",
      "import": "./dist/sqlite.js",
      "default": "./dist/sqlite.js"
    },
    "./checkpoint": {
      "types": "./dist/checkpoint.d.ts",
      "import": "./dist/checkpoint.js",
      "default": "./dist/checkpoint.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown src/index.ts src/checkpoint.ts src/memory.ts src/sqlite.ts src/examples/minimal.ts --format esm --dts --out-dir dist --clean --external effect --external @streamsy/core --external @streamsy/storage",
    "typecheck": "tsc --noEmit",
    "test:unit": "bun test test"
  },
  "dependencies": {
    "@streamsy/core": "workspace:*",
    "@streamsy/storage": "workspace:*",
    "effect": "4.0.0-rc.115"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20251228.0",
    "@effect/sql-sqlite-bun": "4.0.0-rc.115",
    "@effect/sql-sqlite-do": "4.0.0-rc.115",
    "@types/bun": "^1.2.0",
    "miniflare": "4.20260730.0",
    "typescript": "catalog:"
  }
}
