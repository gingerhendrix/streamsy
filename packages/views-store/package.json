{
  "name": "@streamsy/views-store",
  "version": "0.3.0",
  "description": "Backend-neutral maintained-view state, history, checkpoints, and recovery.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sqlite": {
      "types": "./dist/sqlite.d.ts",
      "import": "./dist/sqlite.js"
    },
    "./conformance": {
      "types": "./dist/conformance.d.ts",
      "import": "./dist/conformance.js"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts src/sqlite.ts src/conformance.ts --format esm --dts --out-dir dist --clean --external effect --external bun:sqlite --external bun:test",
    "typecheck": "tsc --noEmit",
    "test": "bun test src",
    "test:unit": "bun test src"
  },
  "dependencies": {
    "effect": "4.0.0-rc.112"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "typescript": "catalog:"
  }
}
