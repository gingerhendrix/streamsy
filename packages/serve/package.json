{
  "name": "@streamsy/serve",
  "version": "0.4.0",
  "description": "Checked state, stream, document, and action sink contracts, routes, protocol handling, and Effect server adapters.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/state.d.ts",
      "import": "./dist/state.js",
      "default": "./dist/state.js"
    },
    "./stream": {
      "types": "./dist/stream.d.ts",
      "import": "./dist/stream.js",
      "default": "./dist/stream.js"
    },
    "./document": {
      "types": "./dist/document.d.ts",
      "import": "./dist/document.js",
      "default": "./dist/document.js"
    },
    "./route": {
      "types": "./dist/route.d.ts",
      "import": "./dist/route.js",
      "default": "./dist/route.js"
    },
    "./route-params": {
      "types": "./dist/route-params.d.ts",
      "import": "./dist/route-params.js",
      "default": "./dist/route-params.js"
    },
    "./fingerprint": {
      "types": "./dist/fingerprint.d.ts",
      "import": "./dist/fingerprint.js",
      "default": "./dist/fingerprint.js"
    },
    "./server/state": {
      "types": "./dist/server/state.d.ts",
      "import": "./dist/server/state.js",
      "default": "./dist/server/state.js"
    },
    "./server/stream": {
      "types": "./dist/server/stream.d.ts",
      "import": "./dist/server/stream.js",
      "default": "./dist/server/stream.js"
    },
    "./server/document": {
      "types": "./dist/server/document.d.ts",
      "import": "./dist/server/document.js",
      "default": "./dist/server/document.js"
    },
    "./action": {
      "types": "./dist/action/contract.d.ts",
      "import": "./dist/action/contract.js",
      "default": "./dist/action/contract.js"
    },
    "./action/errors": {
      "types": "./dist/action/errors.d.ts",
      "import": "./dist/action/errors.js",
      "default": "./dist/action/errors.js"
    },
    "./action/outbox": {
      "types": "./dist/action/outbox.d.ts",
      "import": "./dist/action/outbox.js",
      "default": "./dist/action/outbox.js"
    },
    "./action/runtime": {
      "types": "./dist/action/runtime.d.ts",
      "import": "./dist/action/runtime.js",
      "default": "./dist/action/runtime.js"
    },
    "./action/sqlite": {
      "types": "./dist/action/sqlite.d.ts",
      "import": "./dist/action/sqlite.js",
      "default": "./dist/action/sqlite.js"
    },
    "./bun": {
      "types": "./dist/bun.d.ts",
      "import": "./dist/bun.js",
      "default": "./dist/bun.js"
    },
    "./cloudflare": {
      "types": "./dist/cloudflare.d.ts",
      "import": "./dist/cloudflare.js",
      "default": "./dist/cloudflare.js"
    },
    "./alchemy": {
      "types": "./dist/alchemy.d.ts",
      "import": "./dist/alchemy.js",
      "default": "./dist/alchemy.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown src/state.ts src/stream.ts src/document.ts src/route.ts src/route-params.ts src/fingerprint.ts src/server/state.ts src/server/stream.ts src/server/document.ts src/action/contract.ts src/action/errors.ts src/action/outbox.ts src/action/runtime.ts src/action/sqlite.ts src/bun.ts src/cloudflare.ts src/alchemy.ts --format esm --dts --out-dir dist --clean --deps.never-bundle effect --deps.never-bundle bun:sqlite --deps.never-bundle cloudflare:workers --deps.never-bundle @cloudflare/workers-types",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.cloudflare.json --noEmit && tsc -p tsconfig.cloudflare-tests.json --noEmit",
    "test:unit": "bun test test"
  },
  "dependencies": {
    "@streamsy/core": "workspace:*",
    "effect": "4.0.0-rc.115"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20251228.0",
    "@effect/platform-bun": "4.0.0-rc.115",
    "@effect/sql-sqlite-do": "4.0.0-rc.115",
    "@streamsy/storage": "workspace:*",
    "@types/bun": "^1.2.0",
    "alchemy": "2.0.0-beta.76",
    "miniflare": "4.20260730.0",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@effect/platform-bun": "4.0.0-rc.115",
    "alchemy": "2.0.0-beta.76"
  },
  "peerDependenciesMeta": {
    "@effect/platform-bun": {
      "optional": true
    },
    "alchemy": {
      "optional": true
    }
  },
  "tsdown": {
    "fixedExtension": false
  }
}
