{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "types": ["bun"],
    "baseUrl": ".",
    "paths": {
      "@cloudflare/workers-types": ["test/cloudflare/workers-types-test.d.ts"]
    },
    "skipLibCheck": true
  },
  "include": [
    "src/cloudflare/**/*.test.ts",
    "test/*.bun.test.ts",
    "test/cloudflare-usage.ts",
    "src/alchemy.test.ts",
    "src/alchemy-runtime.test.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
