{
  "name": "@streamsy/conformance-tests",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "test:memory": "bun ./node_modules/vitest/vitest.mjs --run test/memory.conformance.test.ts",
    "test:sqlite": "bun ./node_modules/vitest/vitest.mjs --run test/sqlite.conformance.test.ts",
    "test:node": "bun ./node_modules/vitest/vitest.mjs --run test/node.conformance.test.ts",
    "test:deno": "bun ./node_modules/vitest/vitest.mjs --run test/deno.conformance.test.ts",
    "test:workerd": "bun run build:worker && bun ./node_modules/vitest/vitest.mjs --run --retry=2 test/workerd.conformance.test.ts",
    "test:deployed": "bun ./node_modules/vitest/vitest.mjs --run --retry=2 --testTimeout=60000 --sequence.concurrent --maxConcurrency=20 test/deployed.conformance.test.ts",
    "build:worker": "bun run scripts/build-worker.ts",
    "measure:bundle": "bun run build:worker && cat dist/bundle-report.json",
    "check:browser": "bun scripts/check-browser.ts",
    "test:remote": "bun ./node_modules/vitest/vitest.mjs --run test/remote.conformance.test.ts",
    "test:memory:wildcard": "bun ./node_modules/vitest/vitest.mjs --run test/wildcard.conformance.test.ts",
    "test:pg": "bun ./node_modules/vitest/vitest.mjs --run test/postgres.conformance.test.ts",
    "test:mysql": "bun ./node_modules/vitest/vitest.mjs --run test/mysql.conformance.test.ts"
  },
  "dependencies": {
    "@durable-streams/client": "0.2.6",
    "@durable-streams/server-conformance-tests": "^0.3.5",
    "@durable-streams/state": "0.3.1",
    "@streamsy/core": "workspace:*",
    "@streamsy/serve": "workspace:*",
    "@streamsy/storage": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20251228.0",
    "@effect/platform-deno": "4.0.5",
    "@effect/platform-node": "4.0.5",
    "@effect/sql-mysql2": "4.0.5",
    "@effect/sql-pg": "4.0.5",
    "@effect/sql-sqlite-bun": "4.0.5",
    "@effect/sql-sqlite-do": "4.0.5",
    "@effect/sql-sqlite-node": "4.0.5",
    "@effect/vitest": "catalog:",
    "@types/bun": "^1.2.0",
    "@types/node": "^22.10.0",
    "effect": "4.0.5",
    "miniflare": "4.20260730.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
