{
  "name": "@streamsy/conformance-tests",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:unit": "bun -e \"console.log('No authored conformance unit tests; official memory suite uses test:memory.')\"",
    "test:memory": "bun --bun x vitest --run src/memory.conformance.test.ts"
  },
  "dependencies": {
    "@durable-streams/server-conformance-tests": "^0.3.5",
    "@streamsy/core": "workspace:*",
    "@streamsy/serve": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/node": "^22.10.0",
    "typescript": "catalog:",
    "vitest": "^4.0.16"
  }
}
