{
  "$schema": "./node_modules/@effect/tsgo/oxlint-schema.json",
  "extends": ["./node_modules/@effect/tsgo/oxlint-presets/recommended.json"],
  "plugins": ["effecttsgo"],
  "options": {
    "typeAware": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  // Oxlint always enables the built-in `eslint` rules, and they cannot be turned
  // off at plugin level. The general policy in `.oxlintrc.json` owns those rules
  // for the whole repository, so they are disabled here to keep this inventory
  // limited to Effect diagnostics. `no-shadow` comes in through the `suspicious`
  // category above.
  "rules": {
    "no-underscore-dangle": "off",
    "no-shadow": "off",
    "anti-slop-effect/no-service-constructor-imports": "error",
    "effect-idioms/no-tag-comparison": "error",
    "effect-idioms/no-tag-destructure": "error",
    "effect-idioms/no-tag-literal": "error",
    "effect-idioms/no-tag-switch": "error"
  },
  "overrides": [
    {
      "files": ["packages/storage/test/support/do-worker.ts"],
      "rules": {
        "anti-slop-effect/no-service-constructor-imports": "off"
      }
    },
    {
      // Tests and test support assert encoded wire shapes, so they name `_tag` directly.
      "files": ["**/test/**", "**/*.test.ts", "**/*.test.tsx", "**/src/testing/**"],
      "rules": {
        "effect-idioms/no-tag-comparison": "off",
        "effect-idioms/no-tag-destructure": "off",
        "effect-idioms/no-tag-literal": "off",
        "effect-idioms/no-tag-switch": "off"
      }
    }
  ],
  "env": {
    "builtin": true
  },
  "jsPlugins": [
    {
      "name": "anti-slop-effect",
      "specifier": "./tools/oxlint/anti-slop/effect/index.ts"
    },
    {
      "name": "effect-idioms",
      "specifier": "./tools/oxlint/effect-idioms/index.ts"
    }
  ]
}
